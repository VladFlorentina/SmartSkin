# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key - acces complet la DB, bypass RLS (doar pe backend!)
# Obtine din: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API
# Obtine cheia din: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model primar (20 cereri/zi) -> fallback automat pe GEMINI_FALLBACK_MODEL
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Server Configuration
PORT=3000
NODE_ENV=development
# CORS: origins permise (separate prin virgula)
# Lasa comentat in development; in productie seteaza URL-urile reale
# ALLOWED_ORIGINS=https://smartskin-api.onrender.com,https://smartskin.app
